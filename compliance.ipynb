def add_features(data):

    data = data.copy()

    data["turnover_margin"] = (
        data["turnover_crore"]
        - data["required_turnover_crore"]
    )

    data["experience_margin"] = (
        data["experience_years"]
        - data["required_experience_years"]
    )

    data["technical_margin"] = (
        data["technical_score"]
        - data["minimum_technical_score"]
    )

    data["local_content_margin"] = (
        data["local_content_percent"]
        - data["required_local_content_percent"]
    )

    return data


df = add_features(df)


