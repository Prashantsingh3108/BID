    # --------------------------------------------------------

    st.markdown("### 🎯 Target Distribution")

    target = (
        df["result"]
        .value_counts()
        .reset_index()
    )

    target.columns = [
        "Result",
        "Count"
    ]

    fig = px.bar(
        target,
        x="Result",
        y="Count",
        text_auto=True,
        title="PASS vs FAIL Distribution"
