            y="compliance_score",
            color="result",
            size="turnover_crore",
            hover_data=[
                "tender_id",
                "missing_documents"
            ],
            title="Technical Score vs Compliance"
        )

        st.plotly_chart(
            fig,
            use_container_width=True
        )

    with col2:

        fig = px.scatter(
            filtered,
            x="turnover_crore",
            y="required_turnover_crore",
            color="result",
            hover_data=[
                "tender_id"
            ],
            title="Turnover Requirement Analysis"
        )

        st.plotly_chart(
            fig,
            use_container_width=True
        )

    # Local content
    fig = px.scatter(
        filtered,
        x="local_content_percent",
        y="required_local_content_percent",
        color="result",
        hover_data=["tender_id"],
        title="Local Content Compliance"
    )

    st.plotly_chart(
        fig,
        use_container_width=True
    )


# ============================================================
# PAGE 4 — RISK CENTER
# ============================================================

elif page == "⚠️ Risk Center":

    st.markdown(
        '<div class="section-title">⚠️ Tender Risk Center</div>',
        unsafe_allow_html=True
    )

    df_risk = df.copy()

    df_risk["risk_level"] = df_risk[
        "compliance_score"
    ].apply(risk_level)

    risk_counts = (
        df_risk["risk_level"]
        .value_counts()
        .reindex(
            ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
            fill_value=0
        )
        .reset_index()
    )

    risk_counts.columns = [
        "Risk",
        "Count"
    ]

    fig = px.bar(
        risk_counts,
        x="Risk",
        y="Count",
        text_auto=True,
        title="Risk Distribution"
    )

    st.plotly_chart(
        fig,
        use_container_width=True
    )

    # Top risky tenders

    st.markdown("### 🚨 Highest Risk Tenders")

    risky = (
        df_risk
        .sort_values(
            "compliance_score"
        )
        .head(20)
    )

    display_cols = [
        "tender_id",
        "result",
        "compliance_score",
        "missing_documents",
        "technical_score",
        "local_content_percent",
        "required_local_content_percent"
    ]

    st.dataframe(
        risky[display_cols],
        use_container_width=True,
        hide_index=True
    )

    csv = risky.to_csv(
        index=False
    ).encode("utf-8")

    st.download_button(
        "⬇️ Download Risk Report",
        csv,
        "high_risk_tenders.csv",
        "text/csv"
    )


# ============================================================
# PAGE 5 — TENDER EXPLORER
# ============================================================

elif page == "📋 Tender Explorer":

    st.markdown(
        '<div class="section-title">📋 Tender Explorer</div>',
        unsafe_allow_html=True
    )

    search = st.text_input(
        "🔎 Search Tender ID"
    )

    result_filter = st.multiselect(
        "Filter Result",
        ["PASS", "FAIL"],
        default=["PASS", "FAIL"]
    )

    view = df[
        df["result"].isin(result_filter)
    ]

    if search:

        view = view[
            view["tender_id"]
            .astype(str)
            .str.contains(
                search,
                case=False,
                na=False
            )
        ]

    st.write(
        f"Showing **{len(view):,}** tenders"
    )

    columns = [
        "tender_id",
        "turnover_crore",
        "required_turnover_crore",
        "experience_years",
        "technical_score",
        "technical_compliance",
        "financial_compliance",
        "eligibility_compliance",
        "missing_documents",
        "local_content_percent",
        "compliance_score",
        "result"
    ]

    st.dataframe(
        view[columns],
        use_container_width=True,
        hide_index=True
    )

    csv = view.to_csv(
        index=False
    ).encode("utf-8")

    st.download_button(
        "⬇️ Export Filtered Tenders",
        csv,
        "gem_tenders_filtered.csv",
        "text/csv"
    )


