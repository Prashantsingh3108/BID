def predict_record(record):

    row = pd.DataFrame([record])

    row = add_features(row)

    X = row[FEATURES]

    prediction = model.predict(X)[0]

    if hasattr(model, "predict_proba"):
        probabilities = model.predict_proba(X)[0]

        classes = getattr(
            model,
            "classes_",
            np.array([0, 1])
        )

        pass_probability = 0

        for cls, prob in zip(classes, probabilities):

            if str(cls) == "1":
                pass_probability = prob

            elif encoder is not None:

                try:

                    label = encoder.inverse_transform(
                        [int(cls)]
                    )[0]

                    if label == "PASS":
                        pass_probability = prob

                except:
                    pass

    else:

        pass_probability = 1 if prediction == 1 else 0

    if encoder is not None:

        try:
            label = encoder.inverse_transform(
                [int(prediction)]
            )[0]

        except:
            label = "PASS" if prediction == 1 else "FAIL"

    else:

        label = "PASS" if prediction == 1 else "FAIL"

    return label, float(pass_probability)


def risk_level(score):

    if score >= 85:
        return "LOW"

    if score >= 70:
        return "MEDIUM"

    if score >= 50:
        return "HIGH"

    return "CRITICAL"


def risk_badge(level):

    if level == "LOW":
        return "🟢 LOW"

    if level == "MEDIUM":
        return "🟡 MEDIUM"

    if level == "HIGH":
        return "🟠 HIGH"

    return "🔴 CRITICAL"


def compliance_status(value):

    return "✅ Compliant" if value == 1 else "❌ Non-Compliant"


