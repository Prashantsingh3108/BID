            "Model",
            "Gradient Boosting"
        )

    with c2:
        st.metric(
            "Dataset",
            "5,000"
        )

    with c3:
        st.metric(
            "Features",
            len(FEATURES)
        )

    with c4:
        st.metric(
            "CV F1",
            "94.99%"
        )

    st.markdown("### 🧠 Feature Importance")

    if hasattr(model, "feature_importances_"):

        importance = pd.DataFrame({

            "Feature":
                FEATURES,

            "Importance":
                model.feature_importances_

        }).sort_values(
            "Importance",
