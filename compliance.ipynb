            use_container_width=True,
            hide_index=True
        )

    # --------------------------------------------------------
    # DATA QUALITY
    # --------------------------------------------------------

    st.markdown("### 🔎 Dataset Quality")

    missing = int(
        df.isnull().sum().sum()
    )

    duplicates = int(
        df.duplicated().sum()
    )

    c1, c2, c3 = st.columns(3)

    with c1:
        st.metric(
            "Missing Values",
            missing
        )

    with c2:
        st.metric(
            "Duplicate Rows",
            duplicates
        )

    with c3:
        st.metric(
            "Records",
            len(df)
        )

    # --------------------------------------------------------
